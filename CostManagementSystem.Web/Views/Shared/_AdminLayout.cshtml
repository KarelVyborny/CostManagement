                                    <a class="sidebar-link primary-hover-bg justify-content-between" asp-controller="CostRequest" asp-action="ListRequests">
                                        <div class="d-flex align-items-center gap-6">
                                            <span class="d-flex">
                                                <span class="icon-small"></span>
                                            </span>
                                            <span class="hide-menu">Request list</span>
                                        </div>
                                        @* <span class="hide-menu badge text-bg-primary fs-1 py-1 px-2 rounded-pill">love</span> *@
                                    </a>
                                </li>
                                <li class="sidebar-item">
                                    <a class="sidebar-link primary-hover-bg justify-content-between" asp-controller="CostRequest" asp-action="Create">

                                        <div class="d-flex align-items-center gap-6">
                                            <span class="d-flex">
                                                <span class="icon-small"></span>
                                            </span>
                                            <span class="hide-menu">Create</span>
                                        </div>
                                    </a>
                                </li>
                            </ul>
                        </li>
