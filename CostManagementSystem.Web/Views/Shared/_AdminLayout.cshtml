                                <li class="sidebar-item">
                                    <a class="sidebar-link primary-hover-bg justify-content-between" asp-controller="Periods" asp-action="Index">

                                        <div class="d-flex align-items-center gap-6">
                                            <span class="d-flex">
                                                <span class="icon-small"></span>
                                            </span>
                                            <span class="hide-menu">Periods</span>
                                        </div>
                                    </a>
                                </li>
                               
