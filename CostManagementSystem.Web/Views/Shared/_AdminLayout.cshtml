                    <!--  Header Start -->
                    <header class="app-header">
                        <nav class="navbar navbar-expand-lg navbar-light">
                      
                          
                        </nav>
                    </header>
                    <!--  Header End -->
                    <div class="card">
                        <div class="card-body">
                            @RenderBody()

                        </div>
                    </div>
                </div>
            </div>
