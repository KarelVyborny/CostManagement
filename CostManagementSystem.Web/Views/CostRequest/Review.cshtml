@model ReviewCostRequestVM

@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}


        <h3>Cost Request Review</h3>

        <dl class="row">
            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.CostCode)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(m => m.CostCode)</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Name)</dt> 
            <dd class="col-sm-9">@Html.DisplayFor(m => m.Name)</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.CostDate)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(m => m.CostDate)</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Project)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(m => m.Project)</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Employee)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(m => m.Employee)</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Period)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(m => m.Period)</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Amount)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(m => m.Amount)</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.VAT)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(m => m.VAT)</dd>
        </dl>
   
    <div class="row">
        <div class="col">
            <button type="button" class="btn btn-outline-dark approvalBtn" data-id="@Model.Id" data-approved="true">Approve</button>
        </div>
        <div class="col">
            <button type="button" class="btn btn-outline-dark approvalBtn" data-id="@Model.Id" data-approved="false">Decline</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Back</a>

        </div>
       
    </div>
@* <form id="approvalForm" asp-action="Review" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" id="costRequestId" name="costRequestId" />
    <input type="hidden" id="isApproved" name="isApproved" />
</form> *@

<form id="approvalForm" asp-controller="CostRequest" asp-action="Review" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" id="costRequestId" name="costRequestId" value="@Model.Id" />
    <input type="hidden" id="isApproved" name="isApproved" />
</form>

@section Scripts
{
    <script>
        $(function () {
          $(".approvalBtn").click(function () {
            var btn = $(this);
            $("#costRequestId").val(btn.data("id"));
            $("#isApproved").val(btn.data("approved"));
            $("#approvalForm").submit();
          });
        });
    </script>
    }

