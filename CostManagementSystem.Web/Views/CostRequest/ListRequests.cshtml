@model EmployeeCostRequestListVM
@using CostManagementSystem.Application.Models.CostRequests

@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{

    ViewBag.Title = "View Cost Requests";
}

<h3>Admin Cost Requests</h3>
<div class="row">   
    <div class="col">
        <div class="card">
            <div class="card-body text-center">
                <h3 class="card-title text-primary">@Model.TotalRequests</h3>
                <h5 class="card-text">@Html.DisplayNameFor(model => model.TotalRequests)</h5>
            </div>
        </div>
    </div>

    <div class="col">
        <div class="card">
            <div class="card-body text-center">
                <h3 class="card-title text-primary">@Model.ApprovedRequests</h3>
                <h5 class="card-text">@Html.DisplayNameFor(model => model.ApprovedRequests)</h5>
            </div>
        </div>
    </div>

    <div class="col">
        <div class="card">
            <div class="card-body text-center">
                <h3 class="card-title text-primary">@Model.PendingRequests</h3>
                <h5 class="card-text">@Html.DisplayNameFor(model => model.PendingRequests)</h5>
            </div>
        </div>
    </div>

    <div class="col">
        <div class="card">
            <div class="card-body text-center">
                <h3 class="card-title text-primary">@Model.RejectedRequests</h3>
                <h5 class="card-text">@Html.DisplayNameFor(model => model.RejectedRequests)</h5>
            </div>
        </div>
    </div>
</div>

                <hr/>
<h2>Cost Requests</h2>
<hr/>
@if (Model.CostRequests.Count == 0)
{
    <div class="alert alert-info">
        <h4>there are no request at this time</h4>
    </div>
}
else
{
    <div class="table-responsive">
        <table id="reqTable" class="table table-striped table-sm">
            <thead class="thead-dark">
                <tr>
                   
                    <th class="action-col"></th>
                    <th>Name</th>
                    <th>Cost</th>
                    <th>Date</th>
                    <th>Project</th>
                    <th>@Html.DisplayNameFor(m => m.CostRequests[0].Employee)</th>
                    <th>@Html.DisplayNameFor(m => m.CostRequests[0].Period)</th>
                    <th>Amount</th>
                    <th>@Html.DisplayNameFor(m => m.CostRequests[0].VAT)</th>
                    <th>Status</th>
                    <th>@Html.DisplayNameFor(m => m.CostRequests[0].RequestorId)</th>
                    <th>@Html.DisplayNameFor(m => m.CostRequests[0].ReviewerId)</th>
                    <th>@Html.DisplayNameFor(m => m.CostRequests[0].RequestComment)</th>
                    
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.CostRequests)
                {
                    <tr>
                        <td>
                            @if (item.CostRequestStatus?.Name == "Pending")
                            {
                                <a asp-action="Review" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm">Review</a>
                            }
                            else
                                
                                {
                                    <a asp-action="Review" asp-route-id="@item.Id" class="btn btn-outline-secondary btn-sm">Change</a>
                                }
                        </td>
                        <td>@item.Name</td>
                        <td>@item.CostCode?.CostName</td>
                        <td>@item.CostDate</td>
                        <td>@item.Project?.ProjectName</td>
                        <td>@item.Employee?.FirstName @item.Employee?.LastName</td>
                        <td>@item.Period?.Name</td>
                        <td>@item.Amount</td>
                        <td>@item.VAT</td>
                        <td>@item.CostRequestStatus?.Name</td>
                        <td>@item.Requestor?.FirstName @item.Requestor?.LastName</td>
                        <td>@item.Reviewer?.FirstName @item.Reviewer?.LastName</td>
                        <td>@item.RequestComment</td>
                       
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/jquery.dataTables.min.css" />
    <link rel="stylesheet" href="~/css/costrequests.css" asp-append-version="true" />
}

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script>
         $('#reqTable').DataTable({
            order: [],
            pageLength: 25,
            scrollX: false,
            autoWidth: false,
            columnDefs: [
                { orderable: false, targets: -1 },
                { width: "80px", targets: -1 }
            ]
        });
    </script>
}

    